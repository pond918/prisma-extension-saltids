generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider     = "sqlite"
    url          = "file:../test/test.db"
    relationMode = "prisma"
}

model User {
    id Int @id @default(autoincrement())

    idSalt Int?

    name     String?
    posts    Post[]
    products Product[]
    services Service[]
}

model Post {
    postPk     Int  @id @default(autoincrement())
    postPkSalt Int?

    title String

    authorId     Int?
    authorIdSalt Int?

    author User? @relation(fields: [authorId], references: [id])

    @@index([authorId])
}

model Product {
    id     Int  @id @default(autoincrement())
    idSalt Int?

    name String

    ownerId     Int?
    ownerIdSalt Int?
    owner       User? @relation(fields: [ownerId], references: [id])

    /// 2.1.4 test column: defaulted-0 base mirroring engine's
    /// Provider.engineId / Connector.engineId (sentinel semantics).
    badge     Int? @default(0)
    badgeSalt Int?

    @@index([ownerId])
}

model Service {
    id            Int      @id @default(autoincrement())
    idSalt        Int?

    tenantId_     Int
    tenantId_Salt Int?

    slug          String
    version       String
    deletedAt     BigInt   @default(0)

    name          String
    createdAt     DateTime @default(now())

    tenant        User     @relation(fields: [tenantId_], references: [id])

    @@unique([tenantId_, slug, version, deletedAt])
    @@index([tenantId_])
}
